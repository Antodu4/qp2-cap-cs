#!/usr/bin/env python3
"""
convert output of ORCA to ezfio

Usage:
    qp_convert_orca_to_ezfio [-o EZFIO_DIR] FILE

Options:
    -o --output=EZFIO_DIR    Produced directory
                             by default is FILE.ezfio

"""

import sys
import os
import re
import tempfile
from docopt import docopt

try:
    QP_ROOT = os.environ["QP_ROOT"]
    QP_EZFIO = os.environ["QP_EZFIO"]
except KeyError:
    print("Error: QP_ROOT environment variable not found.")
    sys.exit(1)
else:
    sys.path = [QP_EZFIO + "/Python",
                QP_ROOT + "/install/resultsFile",
                QP_ROOT + "/install",
                QP_ROOT + "/scripts"] + sys.path

from qp_import_trexio import write_ezfio

try:
    from trexio_tools import trexio_run
except:
    print("Error: trexio-tools python package is not installed.")
    print("Use   pip install trexio-tools   to install it.")
    sys.exit(1)

try:
    import scipy
except ImportError:
    print("Error: scipy is not installed (required by trexio-tools for ORCA conversion).")
    print("Use   pip install scipy   to install it.")
    sys.exit(1)


def get_full_path(file_path):
    file_path = os.path.expanduser(file_path)
    file_path = os.path.expandvars(file_path)
    return file_path

class NoneDict(dict):
    def __missing__(self, key):
        return None

def is_json_file(filepath):
    """Retourne True si le fichier commence par '{' (format JSON ORCA)."""
    with open(filepath, 'r', errors='replace') as f:
        for line in f:
            stripped = line.strip()
            if stripped:
                return stripped[0] == '{'
    return False


def sanitize_orca_json(filepath):
    """Return a path to a sanitized copy of the ORCA JSON file.

    ORCA sometimes writes bare NaN/Infinity values that are not valid JSON.
    Replaces them with null so the JSON parser can proceed.
    Returns the original path if no substitution is needed, otherwise a
    NamedTemporaryFile path (caller must delete it).
    """
    with open(filepath, 'r', errors='replace') as f:
        content = f.read()
    # Replace bare NaN / Infinity / nan / inf (case-insensitive) with null
    sanitized = re.sub(r'\bNaN\b', 'null', content, flags=re.IGNORECASE)
    sanitized = re.sub(r'[+-]?Infinity\b', 'null', sanitized, flags=re.IGNORECASE)
    sanitized = re.sub(r'\binf\b', 'null', sanitized, flags=re.IGNORECASE)
    if sanitized == content:
        return filepath, None
    tmp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)
    tmp.write(sanitized)
    tmp.close()
    return tmp.name, tmp.name


def main_json(FILE, EZFIO_FILE):
    """Conversion depuis le format JSON ORCA via trexio_tools."""
    trexio_file = EZFIO_FILE + ".trexio.h5"

    json_input, tmp_path = sanitize_orca_json(FILE)

    args = NoneDict()
    args["convert-from"] = True
    args["--input"] = json_input
    args["--back_end"] = "hdf5"
    args["--type"] = "orca"
    args["TREXIO_FILE"] = trexio_file

    try:
        trexio_run.main(filename=trexio_file, args=args)
    finally:
        if tmp_path is not None:
            os.unlink(tmp_path)

    write_ezfio(trexio_file, EZFIO_FILE)


def main_out(FILE, EZFIO_FILE):
    """Conversion depuis le fichier texte ORCA (.out) via resultsFile."""
    import importlib.util

    # Charge qp_convert_output_to_ezfio comme module (sans exécuter __main__)
    # pour récupérer sa fonction write_ezfio (qui écrit directement dans ezfio).
    # Nécessite SourceFileLoader car le fichier n'a pas d'extension .py.
    from importlib.machinery import SourceFileLoader
    conv_path = os.path.join(QP_ROOT, "bin", "qp_convert_output_to_ezfio")
    loader = SourceFileLoader("qp_convert_output_to_ezfio", conv_path)
    spec = importlib.util.spec_from_file_location("qp_convert_output_to_ezfio", conv_path, loader=loader)
    conv_mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(conv_mod)

    # Cherche la classe ORCA dans conv_mod (qui a fait `from resultsFile import *`)
    # en essayant plusieurs noms possibles selon la version de resultsFile.
    OrcaClass = None
    for name in ('OrcaFile', 'orcaFile', 'Orca', 'OrcaResults'):
        OrcaClass = getattr(conv_mod, name, None)
        if OrcaClass is not None:
            break

    if OrcaClass is None:
        # Dernière tentative : cherche tout symbole callable avec "orca" dans le nom
        for name, obj in vars(conv_mod).items():
            if 'orca' in name.lower() and callable(obj):
                OrcaClass = obj
                break

    if OrcaClass is None:
        print("Error: resultsFile does not have an ORCA text parser.")
        print("Hint: use ORCA JSON format (option '--print' dans ORCA >= 5).")
        sys.exit(1)

    try:
        res = OrcaClass(FILE)
    except Exception as e:
        print(f"Error: resultsFile cannot parse '{os.path.basename(FILE)}': {e}")
        sys.exit(1)

    conv_mod.write_ezfio(res, EZFIO_FILE)


def main(FILE, EZFIO_FILE):
    if is_json_file(FILE):
        main_json(FILE, EZFIO_FILE)
    else:
        print(f"Info: '{os.path.basename(FILE)}' est un fichier texte ORCA, utilisation de resultsFile.")
        main_out(FILE, EZFIO_FILE)


if __name__ == '__main__':
    ARGUMENTS = docopt(__doc__)

    FILE = get_full_path(ARGUMENTS['FILE'])

    if ARGUMENTS["--output"]:
        EZFIO_FILE = get_full_path(ARGUMENTS["--output"])
    else:
        EZFIO_FILE = "{0}.ezfio".format(FILE)

    main(FILE, EZFIO_FILE)
