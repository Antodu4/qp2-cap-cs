#!/usr/bin/env python3
"""
convert output of ORCA to ezfio

Usage:
    qp_convert_orca_to_ezfio [-o EZFIO_DIR] FILE

Options:
    -o --output=EZFIO_DIR    Produced directory
                             by default is FILE.ezfio

"""

import sys
import os
import re
import tempfile
from docopt import docopt

try:
    QP_ROOT = os.environ["QP_ROOT"]
    QP_EZFIO = os.environ["QP_EZFIO"]
except KeyError:
    print("Error: QP_ROOT environment variable not found.")
    sys.exit(1)
else:
    sys.path = [QP_EZFIO + "/Python",
                QP_ROOT + "/install/resultsFile",
                QP_ROOT + "/install",
                QP_ROOT + "/scripts"] + sys.path

from qp_import_trexio import write_ezfio

try:
    from trexio_tools import trexio_run
except:
    print("Error: trexio-tools python package is not installed.")
    print("Use   pip install trexio-tools   to install it.")
    sys.exit(1)

try:
    import scipy
except ImportError:
    print("Error: scipy is not installed (required by trexio-tools for ORCA conversion).")
    print("Use   pip install scipy   to install it.")
    sys.exit(1)


def get_full_path(file_path):
    file_path = os.path.expanduser(file_path)
    file_path = os.path.expandvars(file_path)
    return file_path

class NoneDict(dict):
    def __missing__(self, key):
        return None

def sanitize_orca_json(filepath):
    """Return a path to a sanitized copy of the ORCA JSON file.

    ORCA sometimes writes bare NaN/Infinity values that are not valid JSON.
    Replaces them with null so the JSON parser can proceed.
    Returns the original path if no substitution is needed, otherwise a
    NamedTemporaryFile path (caller must delete it).
    """
    with open(filepath, 'r', errors='replace') as f:
        content = f.read()
    # Replace bare NaN / Infinity (not inside strings) with null
    sanitized = re.sub(r'\bNaN\b', 'null', content)
    sanitized = re.sub(r'\bInfinity\b', 'null', sanitized)
    sanitized = re.sub(r'-Infinity\b', 'null', sanitized)
    if sanitized == content:
        return filepath, None
    tmp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)
    tmp.write(sanitized)
    tmp.close()
    return tmp.name, tmp.name


def main(FILE, EZFIO_FILE):
    trexio_file = EZFIO_FILE + ".trexio.h5"

    json_input, tmp_path = sanitize_orca_json(FILE)

    args = NoneDict()
    args["convert-from"] = True
    args["--input"] = json_input
    args["--back_end"] = "hdf5"
    args["--type"] = "orca"
    args["TREXIO_FILE"] = trexio_file

    try:
        trexio_run.main(filename=trexio_file, args=args)
    finally:
        if tmp_path is not None:
            os.unlink(tmp_path)

    write_ezfio(trexio_file, EZFIO_FILE)


if __name__ == '__main__':
    ARGUMENTS = docopt(__doc__)

    FILE = get_full_path(ARGUMENTS['FILE'])

    if ARGUMENTS["--output"]:
        EZFIO_FILE = get_full_path(ARGUMENTS["--output"])
    else:
        EZFIO_FILE = "{0}.ezfio".format(FILE)

    main(FILE, EZFIO_FILE)
