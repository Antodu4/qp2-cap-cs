#!/usr/bin/env bats

source $QP_ROOT/tests/bats/common.bats.sh
source $QP_ROOT/quantum_package.rc

function run {
  local INPUT=$1
  local EZ=$2
  cp ${QP_ROOT}/tests/input/$INPUT .
  qp convert_orca_to_ezfio $INPUT -o $EZ
  qp set_file $EZ
  qp edit --check
  qp set scf_utils thresh_scf 1.e-12
}

@test "H2O ORCA HF" {
  run h2o.orca.out h2o.orca.ezfio
}

@test "HBO ORCA HF" {
  run hbo.orca.out hbo.orca.ezfio
}

@test "[Cu(NH3)4]2+ ORCA HF" {
  run cu_nh3_4_2plus.orca.out cu_nh3_4_2plus.orca.ezfio
  qp set scf_utils thresh_scf 1.e-10
}

@test "O2 CAS ORCA" {
  run o2_cas.orca.out o2_cas.orca.ezfio
  qp set scf_utils thresh_scf 1.e-10
  qp set_mo_class -c "[1-2]" -a "[3-10]" -v "[11-46]"
}
